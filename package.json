{
  "name": "xcore",
  "version": "0.2.0",
  "description": "XCORE - aplicativo desktop instalável para automação autorizada",
  "main": "app/main/main.js",
  "author": "XCORE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xcore.app",
    "productName": "XCORE",
    "directories": { "output": "release" },
    "files": [
      "app/**/*",
      "core/**/*",
      "integrations/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "XCORE-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
